<!-- Shipping Policy Hero -->
<section style="background: linear-gradient(135deg, #000 0%, #1a1a1a 100%); padding: 80px 0; border-bottom: 1px solid #d4af37;">
  <div class="container-lux" style="max-width: 1400px; margin: 0 auto; padding: 0 40px; text-align: center;">
    <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; color: #d4af37; margin: 0 0 16px 0; text-transform: uppercase;">DELIVERY</p>
    <h1 style="font-size: 3.5rem; font-weight: 700; color: #fff; margin: 0 0 24px 0; letter-spacing: -0.02em; line-height: 1.1;">Shipping Policy</h1>
    <p style="font-size: 1.125rem; color: rgba(255,255,255,0.7); max-width: 700px; margin: 0 auto; line-height: 1.7;">Fast, secure, and fully insured delivery to your doorstep.</p>
  </div>
</section>

<!-- Shipping Options Cards -->
<section style="background: #0a0a0a; padding: 60px 0; border-bottom: 1px solid #d4af37;">
  <div class="container-lux" style="max-width: 1200px; margin: 0 auto; padding: 0 40px;">
    <h2 style="font-size: 2rem; font-weight: 700; color: #fff; margin: 0 0 40px 0; text-align: center;">Shipping Options</h2>
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px;">
      
      <div style="padding: 32px; background: rgba(212,175,55,0.05); border: 2px solid rgba(212,175,55,0.2); border-radius: 12px;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px;">
          <div style="width: 56px; height: 56px; background: rgba(212,175,55,0.1); border: 2px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2">
              <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
          </div>
          <div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #d4af37; margin: 0 0 4px 0;">Standard Shipping</h3>
            <p style="font-size: 1.125rem; font-weight: 600; color: rgba(255,255,255,0.8); margin: 0;">FREE on orders $200+</p>
          </div>
        </div>
        <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); margin: 0 0 12px 0; line-height: 1.6;">Delivery in 3-5 business days</p>
        <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.6;"><strong style="color: #d4af37;">Cost:</strong> $15 flat rate (FREE over $200)</p>
      </div>
      
      <div style="padding: 32px; background: rgba(212,175,55,0.05); border: 2px solid rgba(212,175,55,0.2); border-radius: 12px;">
        <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 16px;">
          <div style="width: 56px; height: 56px; background: rgba(212,175,55,0.1); border: 2px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
          </div>
          <div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: #d4af37; margin: 0 0 4px 0;">Express Shipping</h3>
            <p style="font-size: 1.125rem; font-weight: 600; color: rgba(255,255,255,0.8); margin: 0;">Priority Delivery</p>
          </div>
        </div>
        <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); margin: 0 0 12px 0; line-height: 1.6;">Delivery in 1-2 business days</p>
        <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.6;"><strong style="color: #d4af37;">Cost:</strong> $35 flat rate</p>
      </div>
      
    </div>
  </div>
</section>

<!-- Policy Content -->
<section style="background: #000; padding: 100px 0;">
  <div class="container-lux" style="max-width: 900px; margin: 0 auto; padding: 0 40px;">
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Processing Time</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">All orders are processed within 1-2 business days. Orders placed after 2:00 PM EST will be processed the next business day. Processing time is separate from shipping time.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">During peak seasons (holidays, Valentine's Day, Mother's Day), processing time may be extended to 3-5 business days. We will notify you if there are any delays with your order.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;"><strong style="color: #d4af37;">Custom or engraved items</strong> require 5-7 business days for production before shipping.</p>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Domestic Shipping (United States)</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 24px 0; line-height: 1.8;">We ship to all 50 states including Alaska, Hawaii, and US territories. All domestic shipments are sent via FedEx or UPS with full insurance and tracking.</p>
      
      <div style="background: rgba(212,175,55,0.05); border-left: 3px solid #d4af37; border-radius: 8px; padding: 20px; margin-bottom: 16px;">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #d4af37; margin: 0 0 12px 0;">Standard Shipping (3-5 Business Days)</h3>
        <ul style="margin: 0; padding-left: 20px; color: rgba(255,255,255,0.7); line-height: 1.8;">
          <li style="margin-bottom: 8px;">FREE for orders $200 and above</li>
          <li style="margin-bottom: 8px;">$15 flat rate for orders under $200</li>
          <li style="margin-bottom: 8px;">Fully insured and trackable</li>
          <li>Signature required upon delivery</li>
        </ul>
      </div>
      
      <div style="background: rgba(212,175,55,0.05); border-left: 3px solid #d4af37; border-radius: 8px; padding: 20px;">
        <h3 style="font-size: 1.1rem; font-weight: 700; color: #d4af37; margin: 0 0 12px 0;">Express Shipping (1-2 Business Days)</h3>
        <ul style="margin: 0; padding-left: 20px; color: rgba(255,255,255,0.7); line-height: 1.8;">
          <li style="margin-bottom: 8px;">$35 flat rate for all orders</li>
          <li style="margin-bottom: 8px;">Next-day delivery available in select areas</li>
          <li style="margin-bottom: 8px;">Priority handling and processing</li>
          <li>Fully insured with signature requirement</li>
        </ul>
      </div>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">International Shipping</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">We ship worldwide to over 100 countries. International orders are shipped via DHL Express or FedEx International with full tracking and insurance.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;"><strong style="color: #d4af37;">Delivery Time:</strong> 5-10 business days depending on destination</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;"><strong style="color: #d4af37;">Shipping Cost:</strong> Calculated at checkout based on destination and order weight. Starts at $45.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;"><strong style="color: #d4af37;">Customs & Duties:</strong> International customers are responsible for all customs duties, taxes, and fees imposed by their country. These charges are not included in your order total and are collected by the shipping carrier upon delivery.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;">We properly declare all items and their values on customs forms. We cannot mark items as "gifts" or undervalue products, as this is illegal and may result in shipment delays or seizure.</p>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Order Tracking</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">Once your order ships, you will receive a shipping confirmation email with a tracking number and link to track your package in real-time.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">You can also track your order by logging into your LUXORA account and viewing your order history.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;">Tracking information may take 24 hours to become active in the carrier's system after you receive your shipping notification.</p>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Delivery & Signature Requirement</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">For your security, all jewelry shipments require an <strong style="color: #d4af37;">adult signature (21+)</strong> upon delivery. Packages will not be left unattended.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">If you're not available to sign:</p>
      <ul style="margin: 0 0 16px 0; padding-left: 24px; color: rgba(255,255,255,0.75); line-height: 1.8;">
        <li style="margin-bottom: 8px;">The carrier will leave a delivery notice with instructions</li>
        <li style="margin-bottom: 8px;">You can schedule a redelivery online or by phone</li>
        <li style="margin-bottom: 8px;">You can pick up the package at the carrier's local facility</li>
        <li>After 3 delivery attempts, the package will be returned to us</li>
      </ul>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;">You may also request to have your package held at a FedEx or UPS location for pickup by contacting the carrier directly.</p>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Insurance & Lost Packages</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">Every order is fully insured for its entire value at no additional cost to you. In the rare event that a package is lost or stolen during transit, we will work with the carrier to locate it.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">If the package cannot be located within 7 business days, we will file an insurance claim and either send a replacement or issue a full refund—your choice.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;"><strong style="color: #d4af37;">Important:</strong> Once a package is marked as "Delivered" by the carrier, LUXORA is no longer responsible for the item. Please contact the carrier immediately if you did not receive a delivered package.</p>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Address Changes</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">Please ensure your shipping address is correct before completing your order. Once an order is placed, we cannot change the shipping address.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">If you need to change your address, you must cancel your order (if not yet shipped) and place a new order with the correct address.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;">We ship to the address provided at checkout. We are not responsible for packages delivered to incorrect addresses provided by the customer.</p>
    </div>
    
    <div style="margin-bottom: 48px;">
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Shipping Restrictions</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">We currently do not ship to:</p>
      <ul style="margin: 0; padding-left: 24px; color: rgba(255,255,255,0.75); line-height: 1.8;">
        <li style="margin-bottom: 8px;">PO Boxes or APO/FPO addresses (signature requirement cannot be met)</li>
        <li style="margin-bottom: 8px;">Freight forwarding addresses</li>
        <li>Countries currently under trade sanctions or embargoes</li>
      </ul>
    </div>
    
    <div>
      <h2 style="font-size: 1.75rem; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; padding-bottom: 16px; border-bottom: 1px solid rgba(212,175,55,0.2);">Questions About Shipping?</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 16px 0; line-height: 1.8;">Our customer care team is available to assist with any shipping questions.</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 8px 0; line-height: 1.8;"><strong style="color: #d4af37;">Email:</strong> support@luxorajewelry.com</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0 0 8px 0; line-height: 1.8;"><strong style="color: #d4af37;">Phone:</strong> +1 (555) 123-4567</p>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.75); margin: 0; line-height: 1.8;"><strong style="color: #d4af37;">Hours:</strong> Monday-Friday: 9AM-6PM EST | Saturday: 10AM-4PM EST</p>
    </div>
    
  </div>
</section>

<style>
@media (max-width: 1024px) {
  section > div > div {
    grid-template-columns: 1fr !important;
    gap: 24px !important;
  }
}

@media (max-width: 768px) {
  h1 {
    font-size: 2.5rem !important;
  }
  
  h2 {
    font-size: 1.5rem !important;
  }
  
  h3 {
    font-size: 1.1rem !important;
  }
}
</style>

