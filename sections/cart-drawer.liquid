{% comment %} AJAX slide-out cart. Contents are rendered by theme.js. {% endcomment %}
<div id="CartDrawer" class="drawer" aria-hidden="true" role="dialog" aria-label="Cart">
  <div class="drawer__overlay"></div>
  <aside class="drawer__panel" style="background: #000; color: #fff; border-left: 1px solid rgba(212,175,55,0.2);">
    <header class="flex items-center justify-between border-b px-5 py-4" style="border-color: rgba(212,175,55,0.2);">
      <h2 class="font-display text-lg tracking-[.2em]" style="color: #d4af37;">YOUR CART</h2>
      <button type="button" data-drawer-close aria-label="Close cart" class="text-2xl leading-none transition hover:text-gold" style="color: #fff;">&times;</button>
    </header>

    {%- if section.settings.show_shipping_bar -%}
      <div class="border-b px-5 py-4" data-shipping-progress style="border-color: rgba(212,175,55,0.15); background: rgba(212,175,55,0.05);">
        <p class="text-xs" data-shipping-text style="color: rgba(255,255,255,0.7);"></p>
        <div class="progress mt-2" style="background: rgba(212,175,55,0.2); height: 6px; border-radius: 3px; overflow: hidden;">
          <div class="progress__bar" data-shipping-bar style="background: linear-gradient(90deg, #d4af37, #f4d06f); height: 100%; transition: width 0.3s ease;"></div>
        </div>
      </div>
    {%- endif -%}

    <div class="flex-1 overflow-y-auto px-5 py-4" data-cart-items style="min-height: 200px;">
      {%- if cart.item_count == 0 -%}
        <div style="text-align: center; padding: 60px 20px;">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="rgba(212,175,55,0.3)" stroke-width="1" style="margin: 0 auto 20px;">
            <path d="M6 7h12l1.5 13H4.5z"/><path d="M9 7a3 3 0 0 1 6 0"/>
          </svg>
          <p style="color: rgba(255,255,255,0.6); font-size: 14px; margin-bottom: 8px;">Your cart is empty</p>
          <p style="color: rgba(255,255,255,0.4); font-size: 12px;">Start adding some beautiful jewelry!</p>
          <a href="/collections/all" class="btn btn-gold mt-6" style="display: inline-block; background: #d4af37; color: #000; padding: 12px 32px; font-weight: 700; font-size: 11px; letter-spacing: 0.12em; border-radius: 4px; text-decoration: none; transition: all 0.3s ease;">SHOP NOW</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          {% render 'cart-item', item: item, index: forloop.index %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if settings.enable_cart_upsell and cart.item_count > 0 -%}
      <div class="px-5 py-4" style="border-top: 1px solid rgba(212,175,55,0.15); background: rgba(212,175,55,0.03);">
        {% render 'upsell-products', heading: 'You may also love', limit: 2 %}
      </div>
    {%- endif -%}

    {%- if cart.item_count > 0 -%}
      <footer class="border-t px-5 py-5" style="border-color: rgba(212,175,55,0.2); background: rgba(0,0,0,0.5);">
        <div class="flex items-center justify-between">
          <span class="text-xs uppercase tracking-[.2em]" style="color: rgba(255,255,255,0.6);">Subtotal</span>
          <span class="font-display text-xl" data-cart-total style="color: #d4af37;">{{ cart.total_price | money }}</span>
        </div>
        <p class="mt-1 text-[11px]" style="color: rgba(255,255,255,0.4);">Taxes and shipping calculated at checkout.</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="btn btn-gold mt-4 w-full" style="background: #d4af37; color: #000; padding: 14px; font-weight: 700; letter-spacing: 0.12em; border-radius: 4px; transition: all 0.3s ease; border: none; cursor: pointer;" onmouseover="this.style.background='#e8c854'; this.style.transform='translateY(-1px)'; this.style.boxShadow='0 4px 12px rgba(212,175,55,0.3)'" onmouseout="this.style.background='#d4af37'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">PROCEED TO CHECKOUT</button>
        </form>
        <button type="button" data-drawer-close class="mt-3 w-full text-[11px] uppercase tracking-[.2em] underline transition" style="color: rgba(255,255,255,0.5); background: none; border: none; cursor: pointer;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.5)'">Continue Shopping</button>
      </footer>
    {%- endif -%}
  </aside>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    { "type": "checkbox", "id": "show_shipping_bar", "label": "Show free shipping progress bar", "default": true }
  ]
}
{% endschema %}
