<section class="py-14">
  <div class="container-lux">
    <header class="text-center">
      <p class="eyebrow">Search</p>
      <h1 class="section-title mt-2">{% if search.performed %}Results for "{{ search.terms | escape }}"{% else %}Find your piece{% endif %}</h1>
    </header>

    <form action="{{ routes.search_url }}" method="get" role="search" class="mx-auto mt-8 flex max-w-xl">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for rings, necklaces, gifts…"
             class="w-full border border-black/15 px-5 py-3 text-sm outline-none focus:border-gold" aria-label="Search">
      <button type="submit" class="btn btn-gold shrink-0">Search</button>
    </form>

    {%- if search.performed -%}
      <p class="mt-6 text-center text-xs uppercase tracking-[.18em] text-ink/50">{{ search.results_count }} results</p>
      {%- paginate search.results by 16 -%}
        <div class="mt-8 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="border border-black/10 p-6 transition hover:border-gold">
                <p class="eyebrow">{{ item.object_type }}</p>
                <h3 class="mt-2 font-display text-lg">{{ item.title }}</h3>
                <p class="mt-2 text-sm text-ink/60">{{ item.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {%- endif -%}
          {%- else -%}
            <p class="col-span-full py-16 text-center text-ink/50">No results found. Try another search.</p>
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="mt-12 flex justify-center gap-2">
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}<a href="{{ part.url }}" class="border border-black/15 px-4 py-2 text-sm hover:border-gold">{{ part.title }}</a>
              {%- else -%}<span class="border border-gold bg-navy px-4 py-2 text-sm text-white">{{ part.title }}</span>{%- endif -%}
            {%- endfor -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}{ "name": "Search results" }{% endschema %}
