<!-- Wishlist Hero -->
<section style="background: linear-gradient(135deg, #000 0%, #1a1a1a 100%); padding: 80px 0; border-bottom: 1px solid #d4af37;">
  <div class="container-lux" style="max-width: 1400px; margin: 0 auto; padding: 0 40px; text-align: center;">
    <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; color: #d4af37; margin: 0 0 16px 0; text-transform: uppercase;">YOUR FAVORITES</p>
    <h1 style="font-size: 3.5rem; font-weight: 700; color: #fff; margin: 0 0 24px 0; letter-spacing: -0.02em; line-height: 1.1;">My Wishlist</h1>
    <p style="font-size: 1.125rem; color: rgba(255,255,255,0.7); max-width: 700px; margin: 0 auto; line-height: 1.7;">Save your favorite pieces and shop them later.</p>
  </div>
</section>

<!-- Wishlist Content -->
<section style="background: #000; padding: 100px 0;">
  <div class="container-lux" style="max-width: 1200px; margin: 0 auto; padding: 0 40px;">
    
    <!-- Empty Wishlist State -->
    <div id="emptyWishlist" style="text-align: center; padding: 80px 40px;">
      <div style="width: 120px; height: 120px; background: rgba(212,175,55,0.1); border: 2px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 32px auto;">
        <svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
        </svg>
      </div>
      <h2 style="font-size: 2rem; font-weight: 700; color: #fff; margin: 0 0 16px 0;">Your Wishlist is Empty</h2>
      <p style="font-size: 1rem; color: rgba(255,255,255,0.6); margin: 0 0 32px 0; max-width: 500px; margin-left: auto; margin-right: auto; line-height: 1.7;">Start adding items to your wishlist by clicking the heart icon on any product you love.</p>
      <a href="/collections/all" style="display: inline-block; padding: 16px 40px; background: #d4af37; color: #000; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-decoration: none; border-radius: 8px; transition: all 0.3s ease; text-transform: uppercase;" onmouseover="this.style.background='#e8cd7a'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(212,175,55,0.4)'" onmouseout="this.style.background='#d4af37'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
        Shop All Jewelry
      </a>
    </div>
    
    <!-- Wishlist Info Section -->
    <div style="margin-top: 60px; padding-top: 60px; border-top: 1px solid rgba(212,175,55,0.2);">
      <h2 style="font-size: 2rem; font-weight: 700; color: #fff; margin: 0 0 32px 0; text-align: center;">How to Use Your Wishlist</h2>
      
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px;">
        
        <div style="text-align: center;">
          <div style="width: 72px; height: 72px; background: rgba(212,175,55,0.1); border: 2px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
            <span style="font-size: 2rem; color: #d4af37; font-weight: 700;">1</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #d4af37; margin: 0 0 12px 0;">Browse & Discover</h3>
          <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); line-height: 1.7; margin: 0;">Explore our collections and find pieces that speak to you.</p>
        </div>
        
        <div style="text-align: center;">
          <div style="width: 72px; height: 72px; background: rgba(212,175,55,0.1); border: 2px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
            <span style="font-size: 2rem; color: #d4af37; font-weight: 700;">2</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #d4af37; margin: 0 0 12px 0;">Save Your Favorites</h3>
          <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); line-height: 1.7; margin: 0;">Click the heart icon on any product to add it to your wishlist.</p>
        </div>
        
        <div style="text-align: center;">
          <div style="width: 72px; height: 72px; background: rgba(212,175,55,0.1); border: 2px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
            <span style="font-size: 2rem; color: #d4af37; font-weight: 700;">3</span>
          </div>
          <h3 style="font-size: 1.25rem; font-weight: 700; color: #d4af37; margin: 0 0 12px 0;">Shop When Ready</h3>
          <p style="font-size: 0.95rem; color: rgba(255,255,255,0.6); line-height: 1.7; margin: 0;">Return anytime to view your wishlist and make your purchase.</p>
        </div>
        
      </div>
    </div>
    
    <!-- Benefits Section -->
    <div style="margin-top: 60px; padding: 40px; background: rgba(212,175,55,0.05); border: 1px solid rgba(212,175,55,0.2); border-radius: 12px;">
      <h3 style="font-size: 1.5rem; font-weight: 700; color: #d4af37; margin: 0 0 24px 0; text-align: center;">Why Use a Wishlist?</h3>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px;">
        
        <div style="display: flex; gap: 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" style="flex-shrink: 0;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <h4 style="font-size: 1rem; font-weight: 600; color: #fff; margin: 0 0 6px 0;">Track Your Favorites</h4>
            <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.6;">Keep all your dream pieces in one place.</p>
          </div>
        </div>
        
        <div style="display: flex; gap: 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" style="flex-shrink: 0;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <h4 style="font-size: 1rem; font-weight: 600; color: #fff; margin: 0 0 6px 0;">Share with Loved Ones</h4>
            <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.6;">Perfect for creating gift lists and hints.</p>
          </div>
        </div>
        
        <div style="display: flex; gap: 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" style="flex-shrink: 0;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <h4 style="font-size: 1rem; font-weight: 600; color: #fff; margin: 0 0 6px 0;">Get Notifications</h4>
            <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.6;">Be notified when wishlist items go on sale.</p>
          </div>
        </div>
        
        <div style="display: flex; gap: 16px;">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2" style="flex-shrink: 0;">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <div>
            <h4 style="font-size: 1rem; font-weight: 600; color: #fff; margin: 0 0 6px 0;">Easy Access</h4>
            <p style="font-size: 0.9rem; color: rgba(255,255,255,0.6); margin: 0; line-height: 1.6;">Access your wishlist from any device, anytime.</p>
          </div>
        </div>
        
      </div>
    </div>
    
  </div>
</section>

<style>
@media (max-width: 1024px) {
  section > div > div {
    grid-template-columns: 1fr !important;
    gap: 32px !important;
  }
}

@media (max-width: 768px) {
  h1 {
    font-size: 2.5rem !important;
  }
  
  h2 {
    font-size: 1.75rem !important;
  }
}
</style>

{% schema %}
{
  "name": "Wishlist Page",
  "presets": [{ "name": "Wishlist Page" }]
}
{% endschema %}
