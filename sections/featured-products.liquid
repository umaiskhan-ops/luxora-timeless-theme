{%- assign fp_collection = collections[section.settings.collection] -%}
<section class="bg-navy py-20 text-white">
  <div class="container-lux">
    <div class="text-center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title mt-3 text-white">{{ section.settings.heading }}</h2>
      <div class="divider-diamond mt-4">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.6"><path d="m12 2 10 10-10 10L2 12z"/></svg>
      </div>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-5">
      {%- if fp_collection.products.size > 0 -%}
        {%- for product in fp_collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..5) -%}
          <div class="product-card">
            <div class="product-card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover' }}</div>
            <div class="p-4">
              <h3 class="font-display text-[15px] text-white">Example Product {{ i }}</h3>
              <p class="mt-1 text-sm text-gold">$0.00</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="mt-12 text-center">
        <a href="{{ section.settings.button_link | default: fp_collection.url }}" class="btn btn-outline">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EXQUISITE COLLECTIONS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 3, "max": 12, "step": 1, "default": 5 },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View All Collections" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
