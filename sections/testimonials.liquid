<section class="bg-navy py-20 text-white">
  <div class="container-lux grid gap-12 lg:grid-cols-2 lg:items-center">
    <div class="reveal">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title mt-3 text-white">{{ section.settings.heading }}</h2>
      <p class="mt-4 max-w-md text-sm text-white/60">{{ section.settings.subtext }}</p>

      <div class="mt-8 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {%- for i in (1..4) -%}
          {%- assign stat_key = 'stat_' | append: i -%}
          {%- assign label_key = 'stat_label_' | append: i -%}
          {%- if section.settings[stat_key] != blank -%}
            <div class="text-center">
              <p class="font-display text-2xl text-gold">{{ section.settings[stat_key] }}</p>
              <p class="mt-1 text-[10px] uppercase tracking-[.16em] text-white/50">{{ section.settings[label_key] }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {%- for block in section.blocks -%}
        <figure class="reveal border border-gold/20 bg-white/[.03] p-6 transition hover:border-gold/60" {{ block.shopify_attributes }}>
          <div class="text-gold">★★★★★</div>
          <blockquote class="mt-3 text-sm leading-relaxed text-white/75">"{{ block.settings.quote }}"</blockquote>
          <figcaption class="mt-5 flex items-center gap-3">
            {%- if block.settings.avatar -%}
              <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name | escape }}" class="h-10 w-10 rounded-full object-cover" width="40" height="40" loading="lazy">
            {%- else -%}
              <span class="grid h-10 w-10 place-items-center rounded-full bg-gold/20 font-display text-gold">{{ block.settings.name | slice: 0 }}</span>
            {%- endif -%}
            <div>
              <p class="text-sm font-medium">{{ block.settings.name }}</p>
              <p class="text-[11px] text-white/45">{{ block.settings.role }}</p>
            </div>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Clients Love Us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EXCEPTIONAL ELEGANCE" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Thousands of clients trust LUXORA for life's most meaningful moments." },
    { "type": "text", "id": "stat_1", "label": "Stat 1", "default": "15K+" }, { "type": "text", "id": "stat_label_1", "label": "Stat 1 label", "default": "Happy Customers" },
    { "type": "text", "id": "stat_2", "label": "Stat 2", "default": "25K+" }, { "type": "text", "id": "stat_label_2", "label": "Stat 2 label", "default": "Orders Delivered" },
    { "type": "text", "id": "stat_3", "label": "Stat 3", "default": "4.9" },  { "type": "text", "id": "stat_label_3", "label": "Stat 3 label", "default": "Average Rating" },
    { "type": "text", "id": "stat_4", "label": "Stat 4", "default": "100%" }, { "type": "text", "id": "stat_label_4", "label": "Stat 4 label", "default": "Secure Payment" }
  ],
  "blocks": [
    { "type": "testimonial", "name": "Testimonial", "limit": 4, "settings": [
      { "type": "textarea", "id": "quote", "label": "Quote", "default": "The quality and brilliance of the jewelry I received is beyond my expectations. Absolutely stunning." },
      { "type": "text", "id": "name", "label": "Name", "default": "Sophia Williams" },
      { "type": "text", "id": "role", "label": "Role / location", "default": "Verified Buyer" },
      { "type": "image_picker", "id": "avatar", "label": "Avatar" }
    ]}
  ],
  "presets": [{ "name": "Testimonials", "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }] }]
}
{% endschema %}
