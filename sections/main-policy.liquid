{% comment %} Renders page content or a shop policy. {% endcomment %}
<section class="py-14">
  <div class="container-lux max-w-3xl">
    <header class="text-center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="section-title mt-2">{{ page.title | default: section.settings.heading }}</h1>
    </header>
    <article class="prose prose-sm mt-10 max-w-none space-y-4 text-sm leading-relaxed text-ink/75">
      {%- if page.content != blank -%}
        {{ page.content }}
      {%- else -%}
        {%- case section.settings.policy -%}
          {%- when 'privacy' -%}{{ shop.privacy_policy.body }}
          {%- when 'terms' -%}{{ shop.terms_of_service.body }}
          {%- when 'refund' -%}{{ shop.refund_policy.body }}
          {%- when 'shipping' -%}{{ shop.shipping_policy.body }}
          {%- else -%}<p>Add content to this page in Shopify admin &rarr; Online Store &rarr; Pages.</p>
        {%- endcase -%}
      {%- endif -%}
    </article>
  </div>
</section>
{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Legal" },
    { "type": "text", "id": "heading", "label": "Fallback heading", "default": "Policy" },
    { "type": "select", "id": "policy", "label": "Fallback policy content", "default": "none",
      "options": [
        { "value": "none", "label": "Page content only" },
        { "value": "privacy", "label": "Privacy policy" },
        { "value": "terms", "label": "Terms of service" },
        { "value": "refund", "label": "Refund policy" },
        { "value": "shipping", "label": "Shipping policy" }
      ] }
  ]
}
{% endschema %}
