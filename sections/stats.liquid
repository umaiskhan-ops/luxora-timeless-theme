<section class="bg-navy py-20 text-white">
  <div class="container-lux">
    <div class="text-center">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title mt-3">{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}
        <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-white/60">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="mt-16 grid grid-cols-2 gap-8 lg:grid-cols-4">
        {%- for block in section.blocks -%}
          <div class="text-center" {{ block.shopify_attributes }}>
            <div class="inline-flex h-16 w-16 items-center justify-center rounded-full border-2 border-gold/30 text-gold">
              {%- case block.settings.icon -%}
                {%- when 'items' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 7H4M20 7l1.5 13H2.5L4 7M20 7l-3.5-4M4 7L7.5 3"/><path d="M9 11v6M15 11v6"/></svg>
                {%- when 'customers' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                {%- when 'rating' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="m12 2 2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L12 16.3 6.2 19.8l1.6-6.6L2.6 8.8l6.8-.5z"/></svg>
                {%- when 'guarantee' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                {%- else -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              {%- endcase -%}
            </div>
            <p class="mt-4 font-display text-4xl font-semibold text-gold">{{ block.settings.number }}</p>
            <p class="mt-2 text-sm uppercase tracking-[.18em] text-white/70">{{ block.settings.label }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Stats",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Clients Love Us" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EXCEPTIONAL ELEGANCE" },
    { "type": "textarea", "id": "subtext", "label": "Description" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "limit": 4,
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "items", "label": "Items" },
          { "value": "customers", "label": "Customers" },
          { "value": "rating", "label": "Rating" },
          { "value": "guarantee", "label": "Guarantee" }
        ], "default": "items" },
        { "type": "text", "id": "number", "label": "Number", "default": "15K+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Items completed" }
      ]
    }
  ],
  "presets": [{
    "name": "Stats",
    "blocks": [
      { "type": "stat", "settings": { "icon": "items", "number": "15K+", "label": "Items completed" } },
      { "type": "stat", "settings": { "icon": "customers", "number": "25K+", "label": "Happy Customer" } },
      { "type": "stat", "settings": { "icon": "rating", "number": "4.9", "label": "Average Rating" } },
      { "type": "stat", "settings": { "icon": "guarantee", "number": "100%", "label": "Money back" } }
    ]
  }]
}
{% endschema %}
