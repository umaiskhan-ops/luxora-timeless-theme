<section class="grid grid-cols-1 md:grid-cols-3">
  {%- for block in section.blocks -%}
    <article class="reveal group relative min-h-[280px] overflow-hidden bg-navy" {{ block.shopify_attributes }}>
      {%- if block.settings.image -%}
        <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.heading | escape }}" loading="lazy" width="1200" height="800"
             class="absolute inset-0 h-full w-full object-cover opacity-60 transition duration-700 group-hover:scale-105">
      {%- endif -%}
      <div class="absolute inset-0 bg-gradient-to-r from-navy via-navy/70 to-transparent"></div>
      <div class="relative z-10 flex h-full flex-col justify-center p-8 text-white">
        <p class="eyebrow">{{ block.settings.eyebrow }}</p>
        <h3 class="mt-2 font-display text-2xl leading-tight">{{ block.settings.heading }}</h3>
        <p class="mt-2 text-sm text-white/60">{{ block.settings.text }}</p>
        {%- if block.settings.button_label != blank -%}
          <a href="{{ block.settings.button_link }}" class="btn btn-gold mt-5 self-start">{{ block.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </article>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "Promo banners",
  "blocks": [
    { "type": "banner", "name": "Banner", "limit": 3, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Arrivals" },
      { "type": "text", "id": "heading", "label": "Heading", "default": "JUST FOR YOU" },
      { "type": "text", "id": "text", "label": "Text", "default": "Explore our latest designs" },
      { "type": "text", "id": "button_label", "label": "Button", "default": "Shop Now" },
      { "type": "url", "id": "button_link", "label": "Button link" }
    ]}
  ],
  "presets": [{ "name": "Promo banners", "blocks": [{ "type": "banner" }, { "type": "banner" }, { "type": "banner" }] }]
}
{% endschema %}
