    </div>
    
    <!-- Bottom Row: Copyright + Links -->
    <div style="border-top: 1px solid rgba(212,175,55,0.2); padding: 24px 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <p style="font-size: 12px; color: rgba(255,255,255,0.4); margin: 0;">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All Rights Reserved.
      </p>
      <ul style="list-style: none; padding: 0; margin: 0; display: flex; gap: 24px; flex-wrap: wrap;">
        <li><a href="{{ pages['privacy-policy'].url }}" style="font-size: 12px; color: rgba(255,255,255,0.4); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">Privacy Policy</a></li>
        <li><a href="{{ pages['terms-conditions'].url }}" style="font-size: 12px; color: rgba(255,255,255,0.4); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.4)'">Terms &amp; Conditions</a></li>
