        <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 12px;">
          <li><a href="/collections/best-sellers" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Best Sellers</a></li>
          <li><a href="/collections/new-arrivals" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">New Arrivals</a></li>
          <li><a href="/collections/wedding-collection" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Wedding Collection</a></li>
          <li><a href="/collections/diamond-collection" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Diamond Collection</a></li>
          <li><a href="/collections/gold-collection" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Gold Collection</a></li>
