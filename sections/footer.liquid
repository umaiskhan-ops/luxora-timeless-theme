          <li><a href="/collections/necklaces" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Necklaces</a></li>
          <li><a href="/collections/earrings" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Earrings</a></li>
          <li><a href="/collections/bracelets" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Bracelets</a></li>
