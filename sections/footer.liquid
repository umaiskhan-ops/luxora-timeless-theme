</footer>

<style>
.payment-icon {
  width: 48px;
  height: 32px;
  background: #fff;
  border-radius: 4px;
  padding: 4px;
}

@media (max-width: 1200px) {
  footer > div > div:first-child {
    grid-template-columns: 1fr 1fr 1fr !important;
    gap: 32px !important;
  }
}

@media (max-width: 768px) {
  .newsletter-bar > div > div {
    flex-direction: column !important;
    text-align: center;
  }
  
  .newsletter-bar input[type="email"] {
    text-align: center;
  }
  
  footer > div > div:first-child {
    grid-template-columns: 1fr !important;
    gap: 40px !important;
  }
}
</style>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "header",
      "content": "Newsletter Section"
    },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter Heading", "default": "JOIN OUR EXCLUSIVE CLUB" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter Text", "default": "Subscribe to get special offers, free giveaways, and once-in-a-lifetime deals." },
    {
      "type": "header",
      "content": "Brand Section"
    },
    { "type": "textarea", "id": "brand_text", "label": "Brand Description", "default": "Luxury that shines, beauty that lasts. Crafted for unforgettable moments." },
    {
      "type": "header",
      "content": "Footer Menus"
    },
    { "type": "link_list", "id": "menu_shop", "label": "Shop Menu", "default": "footer" },
    { "type": "link_list", "id": "menu_collections", "label": "Collections Menu", "default": "footer" },
    { "type": "link_list", "id": "menu_customer_care", "label": "Customer Care Menu", "default": "footer" },
    { "type": "link_list", "id": "menu_account", "label": "Account Menu", "default": "footer" },
    {
      "type": "header",
      "content": "Social Media Links"
    },
    { "type": "url", "id": "facebook_url", "label": "Facebook URL" },
    { "type": "url", "id": "instagram_url", "label": "Instagram URL" },
    { "type": "url", "id": "pinterest_url", "label": "Pinterest URL" },
    { "type": "url", "id": "youtube_url", "label": "YouTube URL" },
    { "type": "url", "id": "tiktok_url", "label": "TikTok URL" }
  ]
}
{% endschema %}
