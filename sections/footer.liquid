          <li><a href="/pages/terms-conditions" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Terms & Conditions</a></li>
          <li><a href="/pages/privacy-policy" style="font-size: 13px; color: rgba(255,255,255,0.65); text-decoration: none; transition: color 0.3s ease;" onmouseover="this.style.color='#d4af37'" onmouseout="this.style.color='rgba(255,255,255,0.65)'">Privacy Policy</a></li>
        </ul>
