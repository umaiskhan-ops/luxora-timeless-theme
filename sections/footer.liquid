            <path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18"/>
          </svg>
          <span style="line-height: 1;">
            <span style="display: block; font-size: 24px; font-weight: 700; letter-spacing: 0.15em; color: #d4af37;">LUXORA</span>
