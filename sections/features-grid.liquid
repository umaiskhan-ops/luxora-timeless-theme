<section class="bg-navy text-white">
  <div class="container-lux grid grid-cols-2 gap-y-8 divide-gold/15 py-10 lg:grid-cols-4 lg:divide-x">
    {%- for block in section.blocks -%}
      <div class="reveal flex items-center justify-center gap-4 px-4" {{ block.shopify_attributes }}>
        <span class="grid h-11 w-11 shrink-0 place-items-center rounded-full border border-gold/40 text-gold">
          {%- case block.settings.icon -%}
            {%- when 'truck' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M1 6h12v10H1zM13 9h4l3 3v4h-7z"/><circle cx="5" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
            {%- when 'return' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
            {%- when 'support' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="2" y="14" width="4" height="6" rx="1"/><rect x="18" y="14" width="4" height="6" rx="1"/></svg>
            {%- else -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="10" width="18" height="11" rx="2"/><path d="M7 10V7a5 5 0 0 1 10 0v3"/></svg>
          {%- endcase -%}
        </span>
        <div>
          <p class="text-xs font-semibold uppercase tracking-[.16em]">{{ block.settings.title }}</p>
          <p class="text-[11px] text-white/55">{{ block.settings.text }}</p>
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Features grid",
  "blocks": [
    { "type": "feature", "name": "Feature", "limit": 4, "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "truck",
        "options": [
          { "value": "truck", "label": "Shipping" },
          { "value": "return", "label": "Returns" },
          { "value": "support", "label": "Support" },
          { "value": "lock", "label": "Secure payment" }
        ] },
      { "type": "text", "id": "title", "label": "Title", "default": "Free Shipping" },
      { "type": "text", "id": "text", "label": "Text", "default": "Free worldwide shipping" }
    ]}
  ],
  "presets": [{ "name": "Features grid", "blocks": [
    { "type": "feature", "settings": { "icon": "truck",   "title": "Free Shipping",       "text": "Free worldwide shipping" } },
    { "type": "feature", "settings": { "icon": "return",  "title": "30 Days Returns",     "text": "Easy returns & exchanges" } },
    { "type": "feature", "settings": { "icon": "support", "title": "24/7 Customer Support","text": "We are here to help you" } },
    { "type": "feature", "settings": { "icon": "lock",    "title": "Secure Payment",      "text": "100% secure payment" } }
  ]}]
}
{% endschema %}
