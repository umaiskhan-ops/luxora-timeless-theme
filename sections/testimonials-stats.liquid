<section class="py-20" style="background-color: #000000; border-top: 1px solid #d4af37; border-bottom: 1px solid #d4af37;">
  <div class="container-lux">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
      
      <!-- Left Side: Testimonials + Stats -->
      <div class="testimonial-side" style="border-right: 1px solid #d4af37; padding: 48px 40px;">
        <!-- Header -->
        <p class="eyebrow mb-3">{{ section.settings.eyebrow | default: "OUR CLIENTS LOVE US" }}</p>
        <h2 class="section-title text-white mb-6">{{ section.settings.heading | default: "EXCEPTIONAL ELEGANCE" }}</h2>
        
        <!-- Featured Testimonial -->
        {%- if section.blocks.size > 0 -%}
          {%- assign featured = section.blocks[0] -%}
          <div class="testimonial-featured mb-8">
            <div class="flex items-start gap-3 mb-4">
              <div class="testimonial-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#d4af37">
                  <path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-white/90 text-sm leading-relaxed mb-3">{{ featured.settings.quote | default: "The craftsmanship is a symbol of true beauty. I received is beyond my expectations. Absolutely stunning!" }}</p>
                <div class="flex items-center gap-3">
                  {%- if featured.settings.image -%}
                    <img src="{{ featured.settings.image | image_url: width: 80 }}" alt="{{ featured.settings.name }}" class="testimonial-avatar">
                  {%- else -%}
                    <div class="testimonial-avatar" style="background: linear-gradient(135deg, #e8cd7a, #d4af37);"></div>
                  {%- endif -%}
                  <div>
                    <p class="text-white font-semibold text-sm">{{ featured.settings.name | default: "Sophia Williams" }}</p>
                    <div class="flex gap-1 mt-1">
                      {%- for i in (1..5) -%}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="#d4af37">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
        
        <!-- Stats Grid -->
        <div class="stats-grid grid grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
          {%- for block in section.blocks offset: 1 limit: 4 -%}
            {%- if block.type == 'stat' -%}
              <div class="stat-item text-center">
                <div class="stat-icon mb-3">
                  {%- case block.settings.icon -%}
                    {%- when 'customers' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                      </svg>
                    {%- when 'orders' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
                      </svg>
                    {%- when 'rating' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    {%- when 'payment' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                      </svg>
                  {%- endcase -%}
                </div>
                <p class="stat-value text-gold text-2xl font-bold mb-1">{{ block.settings.value | default: "15K+" }}</p>
                <p class="stat-label text-white/60 text-xs uppercase tracking-wider">{{ block.settings.label | default: "Happy Customers" }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      
      <!-- Right Side: Testimonial Cards Grid -->
      <div class="testimonials-grid-side" style="padding: 48px 40px; background: #000000;">
        <div class="testimonials-cards-grid grid grid-cols-1 md:grid-cols-2 gap-4">
          
          {%- for block in section.blocks offset: 5 limit: 4 -%}
            {%- if block.type == 'testimonial_card' -%}
              <div class="testimonial-card">
                <!-- Stars -->
                <div class="flex gap-1 mb-3">
                  {%- for i in (1..5) -%}
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="#d4af37">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {%- endfor -%}
                </div>
                
                <!-- Quote -->
                <p class="testimonial-card-quote text-white/90 text-sm leading-relaxed mb-4">{{ block.settings.quote }}</p>
                
                <!-- Customer Info -->
                <div class="flex items-center gap-3">
                  <div class="testimonial-card-avatar">{{ block.settings.initial | default: "S" }}</div>
                  <div>
                    <p class="text-white font-semibold text-sm">{{ block.settings.name }}</p>
                    <p class="text-white/50 text-xs">{{ block.settings.badge | default: "Verified Buyer" }}</p>
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
          
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
.testimonial-side {
  background: #000000;
}

.testimonial-icon {
  width: 40px;
  height: 40px;
  background: rgba(212, 175, 55, 0.1);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.testimonial-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(212, 175, 55, 0.4);
}

.stats-grid {
  border-top: 1px solid rgba(212, 175, 55, 0.2);
  padding-top: 24px;
}

.stat-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 48px;
}

.product-showcase-side {
  background: #000000;
  position: relative;
  overflow: hidden;
}

.testimonials-cards-grid {
  gap: 16px;
}

.testimonial-card {
  background: #0a0a0a;
  border: 1px solid rgba(212, 175, 55, 0.15);
  border-radius: 8px;
  padding: 24px;
  transition: all 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
}

.testimonial-card:hover {
  border-color: rgba(212, 175, 55, 0.4);
  transform: translateY(-4px);
  box-shadow: 0 0 0 1px rgba(212,175,55,.3), 0 12px 32px -12px rgba(212,175,55,.4);
}

.testimonial-card-quote {
  line-height: 1.6;
}

.testimonial-card-avatar {
  width: 40px;
  height: 40px;
  background: linear-gradient(135deg, #e8cd7a, #d4af37);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  color: #000;
  font-size: 16px;
  flex-shrink: 0;
}

@media (max-width: 1023px) {
  .testimonial-side,
  .product-showcase-side {
    border-right: none !important;
    border-bottom: 1px solid #d4af37;
  }
  
  .stats-grid {
    grid-template-cols: 2;
  }
  
  .product-showcase-side {
    min-height: 400px;
  }
}
</style>

{% schema %}
{
  "name": "Testimonials + Stats",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR CLIENTS LOVE US" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EXCEPTIONAL ELEGANCE" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer Photo" },
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Sophia Williams" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The craftsmanship is a symbol of true beauty..." }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "customers",
          "options": [
            { "value": "customers", "label": "Customers" },
            { "value": "orders", "label": "Orders" },
            { "value": "rating", "label": "Rating" },
            { "value": "payment", "label": "Payment" }
          ]
        },
        { "type": "text", "id": "value", "label": "Value", "default": "15K+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy Customers" }
      ]
    },
    {
      "type": "testimonial_card",
      "name": "Testimonial Card",
      "settings": [
        { "type": "text", "id": "initial", "label": "Avatar Initial", "default": "S" },
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Sophia Williams" },
        { "type": "text", "id": "badge", "label": "Badge Text", "default": "Verified Buyer" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The quality and brilliance of the jewelry I received is beyond my expectations. Absolutely stunning!" }
      ]
    }
  ],
  "presets": [{
    "name": "Testimonials + Stats",
    "blocks": [
      { "type": "testimonial", "settings": { "name": "Sophia Williams", "quote": "The craftsmanship is a symbol of true beauty. I received is beyond my expectations. Absolutely stunning!" } },
      { "type": "stat", "settings": { "icon": "customers", "value": "15K+", "label": "Happy Customers" } },
      { "type": "stat", "settings": { "icon": "orders", "value": "25K+", "label": "Orders Delivered" } },
      { "type": "stat", "settings": { "icon": "rating", "value": "4.9", "label": "Average Rating" } },
      { "type": "stat", "settings": { "icon": "payment", "value": "100%", "label": "Secure Payment" } },
      { "type": "testimonial_card", "settings": { "initial": "S", "name": "Sophia Williams", "badge": "Verified Buyer", "quote": "The quality and brilliance of the jewelry I received is beyond my expectations. Absolutely stunning!" } },
      { "type": "testimonial_card", "settings": { "initial": "A", "name": "Amelia Carter", "badge": "Verified Buyer", "quote": "My engagement ring is perfect. The packaging alone felt like a gift in itself!" } },
      { "type": "testimonial_card", "settings": { "initial": "I", "name": "Isabella Moore", "badge": "Verified Buyer", "quote": "Fast worldwide delivery and flawless craftsmanship. I will absolutely order again." } },
      { "type": "testimonial_card", "settings": { "initial": "C", "name": "Charlotte Reed", "badge": "Verified Buyer", "quote": "Timeless design that gets compliments every single day. Worth every penny." } }
    ]
  }]
}
{% endschema %}
