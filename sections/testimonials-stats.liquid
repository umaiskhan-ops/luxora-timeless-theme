<section class="py-20" style="background-color: #000000; border-top: 1px solid #d4af37; border-bottom: 1px solid #d4af37;">
  <div class="container-lux">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-0">
      
      <!-- Left Side: Testimonials + Stats -->
      <div class="testimonial-side" style="border-right: 1px solid #d4af37; padding: 48px 40px;">
        <!-- Header -->
        <p class="eyebrow mb-3">{{ section.settings.eyebrow | default: "OUR CLIENTS LOVE US" }}</p>
        <h2 class="section-title text-white mb-6">{{ section.settings.heading | default: "EXCEPTIONAL ELEGANCE" }}</h2>
        
        <!-- Featured Testimonial -->
        {%- if section.blocks.size > 0 -%}
          {%- assign featured = section.blocks[0] -%}
          <div class="testimonial-featured mb-8">
            <div class="flex items-start gap-3 mb-4">
              <div class="testimonial-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="#d4af37">
                  <path d="M12 2L9.19 8.63 2 9.24l5.46 4.73L5.82 21 12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2z"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-white/90 text-sm leading-relaxed mb-3">{{ featured.settings.quote | default: "The craftsmanship is a symbol of true beauty. I received is beyond my expectations. Absolutely stunning!" }}</p>
                <div class="flex items-center gap-3">
                  {%- if featured.settings.image -%}
                    <img src="{{ featured.settings.image | image_url: width: 80 }}" alt="{{ featured.settings.name }}" class="testimonial-avatar">
                  {%- else -%}
                    <div class="testimonial-avatar" style="background: linear-gradient(135deg, #e8cd7a, #d4af37);"></div>
                  {%- endif -%}
                  <div>
                    <p class="text-white font-semibold text-sm">{{ featured.settings.name | default: "Sophia Williams" }}</p>
                    <div class="flex gap-1 mt-1">
                      {%- for i in (1..5) -%}
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="#d4af37">
                          <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                        </svg>
                      {%- endfor -%}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        {%- endif -%}
        
        <!-- Stats Grid -->
        <div class="stats-grid grid grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
          {%- for block in section.blocks offset: 1 limit: 4 -%}
            {%- if block.type == 'stat' -%}
              <div class="stat-item text-center">
                <div class="stat-icon mb-3">
                  {%- case block.settings.icon -%}
                    {%- when 'customers' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                      </svg>
                    {%- when 'orders' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/>
                      </svg>
                    {%- when 'rating' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                      </svg>
                    {%- when 'payment' -%}
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.5">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/><line x1="1" y1="10" x2="23" y2="10"/>
                      </svg>
                  {%- endcase -%}
                </div>
                <p class="stat-value text-gold text-2xl font-bold mb-1">{{ block.settings.value | default: "15K+" }}</p>
                <p class="stat-label text-white/60 text-xs uppercase tracking-wider">{{ block.settings.label | default: "Happy Customers" }}</p>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      
      <!-- Right Side: Product Showcase -->
      <div class="product-showcase-side relative" style="padding: 48px 40px; min-height: 500px;">
        
        <!-- Large Diamond Background Image (Center) -->
        <div class="diamond-bg-image">
          {%- if section.settings.diamond_image -%}
            <img src="{{ section.settings.diamond_image | image_url: width: 600 }}" alt="Diamond" loading="lazy">
          {%- else -%}
            <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=600&q=80" alt="Diamond" loading="lazy">
          {%- endif -%}
        </div>
        
        <!-- Product Images Grid (Overlaid) -->
        <div class="showcase-products-grid">
          {%- if section.settings.product_1 -%}
            <div class="showcase-product showcase-product-1">
              <img src="{{ section.settings.product_1 | image_url: width: 400 }}" alt="Product 1" loading="lazy">
            </div>
          {%- else -%}
            <div class="showcase-product showcase-product-1">
              <img src="https://images.unsplash.com/photo-1605100804763-247f67b3557e?w=400&q=80" alt="Ring" loading="lazy">
            </div>
          {%- endif -%}
          
          {%- if section.settings.product_2 -%}
            <div class="showcase-product showcase-product-2">
              <img src="{{ section.settings.product_2 | image_url: width: 400 }}" alt="Product 2" loading="lazy">
            </div>
          {%- else -%}
            <div class="showcase-product showcase-product-2">
              <img src="https://images.unsplash.com/photo-1515562141207-7a88fb7ce338?w=400&q=80" alt="Necklace" loading="lazy">
            </div>
          {%- endif -%}
          
          {%- if section.settings.product_3 -%}
            <div class="showcase-product showcase-product-3">
              <img src="{{ section.settings.product_3 | image_url: width: 400 }}" alt="Product 3" loading="lazy">
            </div>
          {%- else -%}
            <div class="showcase-product showcase-product-3">
              <img src="https://images.unsplash.com/photo-1611591437281-460bfbe1220a?w=400&q=80" alt="Ring Set" loading="lazy">
            </div>
          {%- endif -%}
          
          <!-- Play Button (decorative) -->
          <button class="showcase-play-btn" aria-label="Play video">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#d4af37">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </button>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
.testimonial-side {
  background: #000000;
}

.testimonial-icon {
  width: 40px;
  height: 40px;
  background: rgba(212, 175, 55, 0.1);
  border: 1px solid rgba(212, 175, 55, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.testimonial-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(212, 175, 55, 0.4);
}

.stats-grid {
  border-top: 1px solid rgba(212, 175, 55, 0.2);
  padding-top: 24px;
}

.stat-icon {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 48px;
}

.product-showcase-side {
  background: #000000;
  position: relative;
  overflow: hidden;
}

.showcase-diamond-bg {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300px;
  height: 300px;
  background: radial-gradient(circle, rgba(212, 175, 55, 0.08), transparent 70%);
  pointer-events: none;
}

.diamond-bg-image {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 280px;
  height: 280px;
  z-index: 0;
  opacity: 0.4;
}

.diamond-bg-image img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: brightness(0.7);
}

.showcase-products-grid {
  position: relative;
  height: 100%;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 16px;
  z-index: 1;
}

.showcase-product {
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid rgba(212, 175, 55, 0.2);
  transition: all 0.4s cubic-bezier(0.22, 0.61, 0.36, 1);
  background: #0a0a0a;
}

.showcase-product:hover {
  transform: scale(1.05);
  border-color: rgba(212, 175, 55, 0.6);
  box-shadow: 0 0 0 1px rgba(212,175,55,.4), 0 12px 32px -12px rgba(212,175,55,.5);
}

.showcase-product img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.showcase-product-1 {
  grid-row: span 2;
}

.showcase-play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 64px;
  height: 64px;
  background: rgba(0, 0, 0, 0.8);
  border: 2px solid #d4af37;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.3s ease;
  z-index: 10;
  padding-left: 4px;
}

.showcase-play-btn:hover {
  background: rgba(212, 175, 55, 0.2);
  transform: translate(-50%, -50%) scale(1.1);
  box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2);
}

@media (max-width: 1023px) {
  .testimonial-side,
  .product-showcase-side {
    border-right: none !important;
    border-bottom: 1px solid #d4af37;
  }
  
  .stats-grid {
    grid-template-cols: 2;
  }
  
  .product-showcase-side {
    min-height: 400px;
  }
}
</style>

{% schema %}
{
  "name": "Testimonials + Stats",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "OUR CLIENTS LOVE US" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "EXCEPTIONAL ELEGANCE" },
    { "type": "image_picker", "id": "diamond_image", "label": "Diamond Background Image (Center)" },
    { "type": "image_picker", "id": "product_1", "label": "Product Image 1 (Large)" },
    { "type": "image_picker", "id": "product_2", "label": "Product Image 2 (Top Right)" },
    { "type": "image_picker", "id": "product_3", "label": "Product Image 3 (Bottom Right)" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer Photo" },
        { "type": "text", "id": "name", "label": "Customer Name", "default": "Sophia Williams" },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The craftsmanship is a symbol of true beauty..." }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "customers",
          "options": [
            { "value": "customers", "label": "Customers" },
            { "value": "orders", "label": "Orders" },
            { "value": "rating", "label": "Rating" },
            { "value": "payment", "label": "Payment" }
          ]
        },
        { "type": "text", "id": "value", "label": "Value", "default": "15K+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy Customers" }
      ]
    }
  ],
  "presets": [{
    "name": "Testimonials + Stats",
    "blocks": [
      { "type": "testimonial", "settings": { "name": "Sophia Williams", "quote": "The craftsmanship is a symbol of true beauty. I received is beyond my expectations. Absolutely stunning!" } },
      { "type": "stat", "settings": { "icon": "customers", "value": "15K+", "label": "Happy Customers" } },
      { "type": "stat", "settings": { "icon": "orders", "value": "25K+", "label": "Orders Delivered" } },
      { "type": "stat", "settings": { "icon": "rating", "value": "4.9", "label": "Average Rating" } },
      { "type": "stat", "settings": { "icon": "payment", "value": "100%", "label": "Secure Payment" } }
    ]
  }]
}
{% endschema %}
