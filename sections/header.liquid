{%- assign menu = linklists[section.settings.menu] | default: linklists.main-menu -%}
{%- if menu.links.size == 0 -%}
  {%- comment %} Default menu structure when no menu is configured {% endcomment -%}
  {%- assign default_menu = true -%}
{%- endif -%}
<header data-header class="sticky top-0 z-50 bg-black text-white transition-all duration-300">
  <div class="container-lux">
    <div class="flex h-[80px] items-center justify-between gap-8">

      {% comment %} Logo {% endcomment %}
      <a href="{{ routes.root_url }}" class="flex items-center gap-2.5">
        {%- if settings.logo -%}
          <img src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="{{ settings.logo_width }}" style="width:{{ settings.logo_width }}px" class="h-auto">
        {%- else -%}
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="1.4"><path d="M6 3h12l3 6-9 12L3 9z"/><path d="M3 9h18M9 3 6 9l6 12M15 3l3 6-6 12"/></svg>
          <span class="leading-none">
            <span class="block font-display text-xl tracking-[.24em]">LUXORA</span>
            <span class="block text-[9px] tracking-[.6em] text-gold">JEWELRY</span>
          </span>
        {%- endif -%}
      </a>

      {% comment %} Desktop Navigation - Center {% endcomment %}
      <nav class="hidden flex-1 items-center justify-center gap-9 lg:flex" aria-label="Main">
        {%- if default_menu -%}
          {% comment %} Default Menu Structure - Only 3 dropdowns: SHOP, COLLECTIONS, PAGES {% endcomment %}
          <div class="group relative">
            <a href="/" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold">HOME</a>
          </div>
          <div class="group relative">
            <a href="/collections" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold">
              SHOP
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class="invisible absolute left-0 top-full z-50 mt-2 w-56 border border-gold/20 bg-black p-3 opacity-0 shadow-2xl transition-all duration-300 group-hover:visible group-hover:mt-0 group-hover:opacity-100">
              <a href="/collections/all" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">All Products</a>
              <a href="/collections/rings" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Rings</a>
              <a href="/collections/necklaces" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Necklaces</a>
              <a href="/collections/earrings" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Earrings</a>
              <a href="/collections/bracelets" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Bracelets</a>
              <a href="/collections/gift-sets" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Gift Sets</a>
            </div>
          </div>
          <div class="group relative">
            <a href="/collections" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold">
              COLLECTIONS
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class="invisible absolute left-0 top-full z-50 mt-2 w-56 border border-gold/20 bg-black p-3 opacity-0 shadow-2xl transition-all duration-300 group-hover:visible group-hover:mt-0 group-hover:opacity-100">
              <a href="/collections/best-sellers" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Best Sellers</a>
              <a href="/collections/new-arrivals" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">New Arrivals</a>
              <a href="/collections/wedding-collection" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Wedding Collection</a>
              <a href="/collections/diamond-collection" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Diamond Collection</a>
              <a href="/collections/gold-collection" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Gold Collection</a>
              <a href="/collections/pearl-collection" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Pearl Collection</a>
            </div>
          </div>
          <div class="group relative">
            <a href="/collections/new-arrivals" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold">NEW ARRIVALS</a>
          </div>
          <div class="group relative">
            <a href="/pages/about-us" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold">ABOUT US</a>
          </div>
          <div class="group relative">
            <a href="#" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold">
              PAGES
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </a>
            <div class="invisible absolute left-0 top-full z-50 mt-2 w-56 border border-gold/20 bg-black p-3 opacity-0 shadow-2xl transition-all duration-300 group-hover:visible group-hover:mt-0 group-hover:opacity-100">
              <a href="/pages/contact-us" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Contact Us</a>
              <a href="/pages/faqs" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">FAQs</a>
              <a href="/pages/shipping-policy" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Shipping Policy</a>
              <a href="/pages/return-policy" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Return Policy</a>
              <a href="/pages/terms-conditions" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Terms & Conditions</a>
              <a href="/pages/privacy-policy" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Privacy Policy</a>
              <a href="/pages/wishlist" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Wishlist</a>
              <a href="/pages/careers" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold">Careers</a>
            </div>
          </div>
        {%- else -%}
          {% comment %} Custom Menu from Shopify Admin {% endcomment %}
          {%- for link in menu.links -%}
            <div class="group relative">
              <a href="{{ link.url }}" class="flex items-center gap-1.5 text-[11px] font-medium uppercase tracking-[.2em] transition-colors hover:text-gold {% if link.active %}text-gold{% endif %}">
                {{ link.title }}
                {%- if link.links.size > 0 -%}
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
                {%- endif -%}
              </a>
              {%- if link.links.size > 0 -%}
                <div class="invisible absolute left-0 top-full z-50 mt-2 w-56 border border-gold/20 bg-black p-3 opacity-0 shadow-2xl transition-all duration-300 group-hover:visible group-hover:mt-0 group-hover:opacity-100">
                  {%- for child in link.links -%}
                    <a href="{{ child.url }}" class="block px-3 py-2.5 text-sm transition hover:bg-white/5 hover:text-gold {% if child.active %}text-gold{% endif %}">{{ child.title }}</a>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        {%- endif -%}
      </nav>

      {% comment %} Actions - Right Side {% endcomment %}
      <div class="flex items-center gap-5">
        {% comment %} Mobile hamburger {% endcomment %}
        <button type="button" class="lg:hidden" data-drawer-open="MobileMenu" aria-label="Open menu">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>

        {% comment %} Search {% endcomment %}
        <button type="button" data-drawer-open="SearchDrawer" aria-label="Search" class="transition hover:text-gold">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </button>

        {% comment %} Account {% endcomment %}
        <a href="{{ routes.account_url }}" aria-label="Account" class="hidden transition hover:text-gold sm:block">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>
        </a>

        {% comment %} Wishlist with badge {% endcomment %}
        <a href="/pages/wishlist" aria-label="Wishlist" class="relative hidden transition hover:text-gold sm:block">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 1 0-7.8 7.8L12 21.2l8.8-8.8a5.5 5.5 0 0 0 0-7.8z"/></svg>
          <span class="absolute -right-1.5 -top-1.5 grid h-4 min-w-4 place-items-center rounded-full bg-gold px-1 text-[10px] font-semibold text-black">0</span>
        </a>

        {% comment %} Cart with count {% endcomment %}
        <button type="button" data-drawer-open="CartDrawer" aria-label="Open cart" class="relative transition hover:text-gold">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 7h12l1.5 13H4.5z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
          <span data-cart-count class="absolute -right-1.5 -top-1.5 grid h-4 min-w-4 place-items-center rounded-full bg-gold px-1 text-[10px] font-semibold text-black {% if cart.item_count == 0 %}hidden{% endif %}">{{ cart.item_count }}</span>
        </button>
      </div>
    </div>
  </div>
</header>

{% comment %} Mobile menu drawer {% endcomment %}
<div id="MobileMenu" class="drawer lg:hidden" aria-hidden="true">
  <div class="drawer__overlay"></div>
  <aside class="drawer__panel drawer__panel--left" style="background: #000;">
    <div class="flex items-center justify-between border-b border-white/10 px-5 py-4">
      <span class="font-display text-lg tracking-[.2em]">MENU</span>
      <button type="button" data-drawer-close aria-label="Close menu" class="text-2xl leading-none">&times;</button>
    </div>
    <nav class="flex-1 overflow-y-auto px-5 py-4">
      {%- if default_menu -%}
        {% comment %} Default Mobile Menu - Only 3 dropdowns {% endcomment %}
        <div class="border-b border-white/5 py-1">
          <a href="/" class="block py-3 text-sm uppercase tracking-[.16em]">HOME</a>
        </div>
        <div class="border-b border-white/5 py-1">
          <div class="flex items-center justify-between">
            <a href="/collections/all" class="block py-3 text-sm uppercase tracking-[.16em]">SHOP</a>
            <button type="button" data-submenu-toggle aria-label="Expand" class="p-2">+</button>
          </div>
          <div data-submenu class="hidden pb-3 pl-3">
            <a href="/collections/all" class="block py-2 text-sm text-white/70 hover:text-gold">All Products</a>
            <a href="/collections/rings" class="block py-2 text-sm text-white/70 hover:text-gold">Rings</a>
            <a href="/collections/necklaces" class="block py-2 text-sm text-white/70 hover:text-gold">Necklaces</a>
            <a href="/collections/earrings" class="block py-2 text-sm text-white/70 hover:text-gold">Earrings</a>
            <a href="/collections/bracelets" class="block py-2 text-sm text-white/70 hover:text-gold">Bracelets</a>
            <a href="/collections/gift-sets" class="block py-2 text-sm text-white/70 hover:text-gold">Gift Sets</a>
          </div>
        </div>
        <div class="border-b border-white/5 py-1">
          <div class="flex items-center justify-between">
            <a href="/collections" class="block py-3 text-sm uppercase tracking-[.16em]">COLLECTIONS</a>
            <button type="button" data-submenu-toggle aria-label="Expand" class="p-2">+</button>
          </div>
          <div data-submenu class="hidden pb-3 pl-3">
            <a href="/collections/best-sellers" class="block py-2 text-sm text-white/70 hover:text-gold">Best Sellers</a>
            <a href="/collections/new-arrivals" class="block py-2 text-sm text-white/70 hover:text-gold">New Arrivals</a>
            <a href="/collections/wedding-collection" class="block py-2 text-sm text-white/70 hover:text-gold">Wedding Collection</a>
            <a href="/collections/diamond-collection" class="block py-2 text-sm text-white/70 hover:text-gold">Diamond Collection</a>
            <a href="/collections/gold-collection" class="block py-2 text-sm text-white/70 hover:text-gold">Gold Collection</a>
            <a href="/collections/pearl-collection" class="block py-2 text-sm text-white/70 hover:text-gold">Pearl Collection</a>
          </div>
        </div>
        <div class="border-b border-white/5 py-1">
          <a href="/collections/new-arrivals" class="block py-3 text-sm uppercase tracking-[.16em]">NEW ARRIVALS</a>
        </div>
        <div class="border-b border-white/5 py-1">
          <a href="/pages/about-us" class="block py-3 text-sm uppercase tracking-[.16em]">ABOUT US</a>
        </div>
        <div class="border-b border-white/5 py-1">
          <div class="flex items-center justify-between">
            <span class="block py-3 text-sm uppercase tracking-[.16em]">PAGES</span>
            <button type="button" data-submenu-toggle aria-label="Expand" class="p-2">+</button>
          </div>
          <div data-submenu class="hidden pb-3 pl-3">
            <a href="/pages/contact-us" class="block py-2 text-sm text-white/70 hover:text-gold">Contact Us</a>
            <a href="/pages/faqs" class="block py-2 text-sm text-white/70 hover:text-gold">FAQs</a>
            <a href="/pages/shipping-policy" class="block py-2 text-sm text-white/70 hover:text-gold">Shipping Policy</a>
            <a href="/pages/return-policy" class="block py-2 text-sm text-white/70 hover:text-gold">Return Policy</a>
            <a href="/pages/terms-conditions" class="block py-2 text-sm text-white/70 hover:text-gold">Terms & Conditions</a>
            <a href="/pages/privacy-policy" class="block py-2 text-sm text-white/70 hover:text-gold">Privacy Policy</a>
            <a href="/pages/wishlist" class="block py-2 text-sm text-white/70 hover:text-gold">Wishlist</a>
            <a href="/pages/careers" class="block py-2 text-sm text-white/70 hover:text-gold">Careers</a>
          </div>
        </div>
      {%- else -%}
        {% comment %} Custom Mobile Menu {% endcomment %}
        {%- for link in menu.links -%}
          <div class="border-b border-white/5 py-1">
            <div class="flex items-center justify-between">
              <a href="{{ link.url }}" class="block py-3 text-sm uppercase tracking-[.16em] {% if link.active %}text-gold{% endif %}">{{ link.title }}</a>
              {%- if link.links.size > 0 -%}
                <button type="button" data-submenu-toggle aria-label="Expand" class="p-2">+</button>
              {%- endif -%}
            </div>
            {%- if link.links.size > 0 -%}
              <div data-submenu class="hidden pb-3 pl-3">
                {%- for child in link.links -%}
                  <a href="{{ child.url }}" class="block py-2 text-sm text-white/70 hover:text-gold {% if child.active %}text-gold{% endif %}">{{ child.title }}</a>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </nav>
    <div class="border-t border-white/10 p-5">
      <a href="{{ routes.account_url }}" class="btn btn-gold w-full">{% if customer %}{{ customer.name }}{% else %}Account{% endif %}</a>
      <div class="mt-4">{% render 'social-icons' %}</div>
    </div>
  </aside>
</div>

{% comment %} Search drawer {% endcomment %}
<div id="SearchDrawer" class="drawer" aria-hidden="true">
  <div class="drawer__overlay"></div>
  <aside class="drawer__panel">
    <div class="flex items-center justify-between border-b border-black/10 px-5 py-4">
      <span class="font-display text-lg">Search</span>
      <button type="button" data-drawer-close aria-label="Close search" class="text-2xl leading-none">&times;</button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search" class="p-5">
      <input type="search" name="q" placeholder="Search for rings, necklaces, gifts…" class="w-full border border-black/15 px-4 py-3 text-sm outline-none focus:border-gold" autocomplete="off">
      <button type="submit" class="btn btn-gold mt-4 w-full">Search</button>
    </form>
  </aside>
</div>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" }
  ]
}
{% endschema %}
