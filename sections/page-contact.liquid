<!-- Contact Hero -->
<section style="background: linear-gradient(135deg, #000 0%, #1a1a1a 100%); padding: 80px 0; border-bottom: 1px solid #d4af37;">
  <div class="container-lux" style="max-width: 1400px; margin: 0 auto; padding: 0 40px; text-align: center;">
    <p style="font-size: 11px; font-weight: 700; letter-spacing: 0.15em; color: #d4af37; margin: 0 0 16px 0; text-transform: uppercase;">GET IN TOUCH</p>
    <h1 style="font-size: 3.5rem; font-weight: 700; color: #fff; margin: 0 0 24px 0; letter-spacing: -0.02em; line-height: 1.1;">Contact Us</h1>
    <p style="font-size: 1.125rem; color: rgba(255,255,255,0.7); max-width: 700px; margin: 0 auto; line-height: 1.7;">We're here to help with any questions about our jewelry, orders, or custom designs.</p>
  </div>
</section>

<!-- Contact Form + Info -->
<section style="background: #000; padding: 100px 0;">
  <div class="container-lux" style="max-width: 1200px; margin: 0 auto; padding: 0 40px;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px;">
      
      <!-- Left: Contact Form -->
      <div>
        <h2 style="font-size: 2rem; font-weight: 700; color: #fff; margin: 0 0 12px 0;">Send Us a Message</h2>
        <p style="font-size: 1rem; color: rgba(255,255,255,0.6); margin: 0 0 32px 0;">Fill out the form below and we'll get back to you within 24 hours.</p>
        
        {% form 'contact' %}
          {%- if form.posted_successfully? -%}
            <div style="padding: 16px 20px; background: rgba(212,175,55,0.1); border: 1px solid #d4af37; border-radius: 8px; margin-bottom: 24px;">
              <p style="color: #d4af37; margin: 0; font-size: 14px; font-weight: 600;">✓ Thank you! We'll be in touch soon.</p>
            </div>
          {%- endif -%}
          
          {%- if form.errors -%}
            <div style="padding: 16px 20px; background: rgba(220,38,38,0.1); border: 1px solid #dc2626; border-radius: 8px; margin-bottom: 24px;">
              <p style="color: #dc2626; margin: 0; font-size: 14px; font-weight: 600;">Please fix the errors below.</p>
            </div>
          {%- endif -%}
          
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #d4af37; margin-bottom: 8px; letter-spacing: 0.05em;">NAME *</label>
            <input type="text" name="contact[name]" required style="width: 100%; padding: 14px 16px; background: #0a0a0a; border: 1px solid rgba(212,175,55,0.3); border-radius: 8px; color: #fff; font-size: 14px; outline: none; transition: all 0.3s ease;" onfocus="this.style.borderColor='#d4af37'" onblur="this.style.borderColor='rgba(212,175,55,0.3)'">
          </div>
          
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #d4af37; margin-bottom: 8px; letter-spacing: 0.05em;">EMAIL *</label>
            <input type="email" name="contact[email]" required style="width: 100%; padding: 14px 16px; background: #0a0a0a; border: 1px solid rgba(212,175,55,0.3); border-radius: 8px; color: #fff; font-size: 14px; outline: none; transition: all 0.3s ease;" onfocus="this.style.borderColor='#d4af37'" onblur="this.style.borderColor='rgba(212,175,55,0.3)'">
          </div>
          
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #d4af37; margin-bottom: 8px; letter-spacing: 0.05em;">PHONE</label>
            <input type="tel" name="contact[phone]" style="width: 100%; padding: 14px 16px; background: #0a0a0a; border: 1px solid rgba(212,175,55,0.3); border-radius: 8px; color: #fff; font-size: 14px; outline: none; transition: all 0.3s ease;" onfocus="this.style.borderColor='#d4af37'" onblur="this.style.borderColor='rgba(212,175,55,0.3)'">
          </div>
          
          <div style="margin-bottom: 20px;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: #d4af37; margin-bottom: 8px; letter-spacing: 0.05em;">MESSAGE *</label>
            <textarea name="contact[body]" required rows="5" style="width: 100%; padding: 14px 16px; background: #0a0a0a; border: 1px solid rgba(212,175,55,0.3); border-radius: 8px; color: #fff; font-size: 14px; outline: none; transition: all 0.3s ease; resize: vertical;" onfocus="this.style.borderColor='#d4af37'" onblur="this.style.borderColor='rgba(212,175,55,0.3)'"></textarea>
          </div>
          
          <button type="submit" style="width: 100%; padding: 16px; background: #d4af37; color: #000; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; border: none; border-radius: 8px; cursor: pointer; transition: all 0.3s ease; text-transform: uppercase;" onmouseover="this.style.background='#e8cd7a'; this.style.transform='translateY(-2px)'; this.style.boxShadow='0 8px 24px rgba(212,175,55,0.4)'" onmouseout="this.style.background='#d4af37'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            Send Message
          </button>
        {% endform %}
      </div>
      
      <!-- Right: Contact Info -->
      <div>
        <h2 style="font-size: 2rem; font-weight: 700; color: #fff; margin: 0 0 12px 0;">Contact Information</h2>
        <p style="font-size: 1rem; color: rgba(255,255,255,0.6); margin: 0 0 40px 0;">Reach out through any of these channels.</p>
        
        <!-- Email -->
        <div style="display: flex; gap: 20px; margin-bottom: 32px;">
          <div style="width: 56px; height: 56px; background: rgba(212,175,55,0.1); border: 1px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 8l10 6 10-6"/>
            </svg>
          </div>
          <div>
            <h3 style="font-size: 14px; font-weight: 700; color: #d4af37; margin: 0 0 8px 0; letter-spacing: 0.05em;">EMAIL</h3>
            <p style="font-size: 16px; color: rgba(255,255,255,0.8); margin: 0;">support@luxorajewelry.com</p>
          </div>
        </div>
        
        <!-- Phone -->
        <div style="display: flex; gap: 20px; margin-bottom: 32px;">
          <div style="width: 56px; height: 56px; background: rgba(212,175,55,0.1); border: 1px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <h3 style="font-size: 14px; font-weight: 700; color: #d4af37; margin: 0 0 8px 0; letter-spacing: 0.05em;">PHONE</h3>
            <p style="font-size: 16px; color: rgba(255,255,255,0.8); margin: 0;">+1 (555) 123-4567</p>
          </div>
        </div>
        
        <!-- Address -->
        <div style="display: flex; gap: 20px; margin-bottom: 40px;">
          <div style="width: 56px; height: 56px; background: rgba(212,175,55,0.1); border: 1px solid #d4af37; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#d4af37" stroke-width="2">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div>
            <h3 style="font-size: 14px; font-weight: 700; color: #d4af37; margin: 0 0 8px 0; letter-spacing: 0.05em;">ADDRESS</h3>
            <p style="font-size: 16px; color: rgba(255,255,255,0.8); margin: 0; line-height: 1.6;">123 Luxury Ave<br>Beverly Hills, CA 90210<br>United States</p>
          </div>
        </div>
        
        <!-- Hours -->
        <div style="padding: 24px; background: #0a0a0a; border: 1px solid rgba(212,175,55,0.3); border-radius: 12px;">
          <h3 style="font-size: 14px; font-weight: 700; color: #d4af37; margin: 0 0 16px 0; letter-spacing: 0.05em;">BUSINESS HOURS</h3>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span style="font-size: 14px; color: rgba(255,255,255,0.6);">Monday - Friday</span>
            <span style="font-size: 14px; color: rgba(255,255,255,0.9); font-weight: 600;">9:00 AM - 6:00 PM</span>
          </div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
            <span style="font-size: 14px; color: rgba(255,255,255,0.6);">Saturday</span>
            <span style="font-size: 14px; color: rgba(255,255,255,0.9); font-weight: 600;">10:00 AM - 4:00 PM</span>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="font-size: 14px; color: rgba(255,255,255,0.6);">Sunday</span>
            <span style="font-size: 14px; color: rgba(255,255,255,0.9); font-weight: 600;">Closed</span>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
@media (max-width: 768px) {
  section > div > div {
    grid-template-columns: 1fr !important;
    gap: 60px !important;
  }
  
  h1 {
    font-size: 2.5rem !important;
  }
}
</style>

{% schema %}
{
  "name": "Contact Page",
  "presets": [{ "name": "Contact Page" }]
}
{% endschema %}
